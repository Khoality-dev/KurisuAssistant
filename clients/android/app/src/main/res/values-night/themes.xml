<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark counterpart of values/themes.xml. The launch theme paints the window before
      Compose draws, so without this the app flashes a white window on a dark cold start.
    -->
    <style name="Theme.KurisuAssistant" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
