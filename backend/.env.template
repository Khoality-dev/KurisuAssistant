POSTGRES_USER=kurisu
POSTGRES_PASSWORD=kurisu
POSTGRES_HOST=postgres-container
POSTGRES_PORT=5432
POSTGRES_DB=kurisu

# Where the API listens on this machine. The clients connect to
# http://<this host>:15597 unless you put a reverse proxy in front — start with
# `--profile tls` for the bundled HTTPS option. Set API_BIND=127.0.0.1 to keep
# the port off the network when something else fronts it.
API_PORT=15597
API_BIND=0.0.0.0

# With `--profile tls`, nginx terminates HTTPS here using the certificate from
# ./nginx/generate-certs.sh. Set API_BIND=127.0.0.1 alongside it so the plain
# HTTP port stays off the network.
HTTPS_PORT=443

# Largest accepted image upload, in bytes. Read into memory whole, so keep it
# well under the RAM available to the API container.
MAX_IMAGE_BYTES=16777216

# Kurisu Drive: how much each account may store, and the largest single file.
# Defaults are 15 GB per account and 2 GB per file. With the tls profile in
# front, nginx's own limit for /drive/ applies as well.
DRIVE_QUOTA_BYTES=16106127360
DRIVE_MAX_FILE_BYTES=2147483648

# Recall: the assistant can search past conversations and drive files by
# pattern and by meaning. Meaning needs an embedding model, and it is one model
# for the whole server (every stored vector must come from the same one):
# ollama pulls it from LLM_API_URL on first use; gemini or nvidia use the keys
# below. Leave EMBEDDING_MODEL empty to switch semantic recall off — recall by
# pattern keeps working. Files over the byte cap, and passages past the per-file
# cap, are not indexed.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# RETRIEVAL_MAX_FILE_BYTES=20971520
# RETRIEVAL_MAX_PASSAGES_PER_FILE=2000

# The model server. The default reaches an Ollama running on this machine
# (host.docker.internal is mapped to the host for exactly this). Point it
# somewhere else if Ollama lives on another box, or leave it and use a cloud
# provider key instead — each user picks their provider in the app.
#
# On Linux this needs one thing at the other end: a stock Ollama listens on
# 127.0.0.1 and will refuse the container. Start it with OLLAMA_HOST=0.0.0.0
# (or set that in its systemd unit). Docker Desktop needs nothing.
LLM_API_URL=http://host.docker.internal:11434

# Speech. Each engine is a published image this stack pulls, behind its own
# profile and needing an NVIDIA GPU; the backend only talks to them over HTTP
# and carries no model code of its own. Start what you want:
#
#   docker compose --profile whisper --profile gpt-sovits up -d
#
# Every address below has a default that reaches the matching profile, so the
# line above is all it takes. Clear one, or point it somewhere else, to use an
# engine you already run — that is also how viXTTS is reached, since it has no
# published image yet. An engine with no address is not part of this
# deployment, and a request for it says so rather than failing quietly.
# ASR_URL=http://kurisu-whisper:9000
# GPTSOVITS_URL=http://kurisu-gpt-sovits:9880
VIXTTS_URL=

# Which synthesis engine answers a request that names none.
# TTS_DEFAULT_MODEL=gpt-sovits

# Recognition. One model per container, so this is the operator's choice, not
# the request's: tiny, base, small, medium, large-v3, or a Hugging Face id. The
# API reads the same value to name the model in the client's picker. The engine
# drops the weights after this many idle seconds and reloads on the next clip
# (0 keeps them resident), which is the only idle unloading there is now that
# no engine runs in a process this project controls.
# ASR_MODEL=base
# ASR_DEVICE=cuda
# ASR_IDLE_TIMEOUT=300

# GPT-SoVITS opens the reference clip itself, so the stack mounts
# data/voice_storage/ into it read-only; this is where it sees that directory.
# The language it assumes when a request names none.
# GPTSOVITS_VOICE_DIR=/voice_storage
# GPTSOVITS_DEFAULT_LANGUAGE=ja
#
# If you run speech elsewhere, leave the profile off and point the two URLs
# below at it instead.
# ASR_API_URL=http://universal-voice:14213
# UVOICE_URL=http://universal-voice:14213

# Account creation. Open by default, because registering grants nothing: a new
# account is inactive until you activate it yourself, which is the only way any
# account comes to exist — nothing is seeded.
#
# The statement is:
#
#   UPDATE users SET is_active = true WHERE username = 'name';
#
# How to run it against this stack: docs/operations.md#accounts.

# Brute-force protection on /login and /register, per client address.
# Set AUTH_RATE_LIMIT_MAX_ATTEMPTS=0 to disable.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# The same window, counted per username instead of per address. It is the only
# limit that still bounds guessing when many callers share one address (a proxy,
# NAT) or when one attacker has many addresses. The trade is that someone who
# knows a username can keep that account refused for a window; 0 disables it.
AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_USER=20

# Whose X-Forwarded-For header to believe, as addresses or CIDR subnets,
# comma-separated. Leave empty when nothing is in front of the API: the header
# is then ignored and the per-address limit counts the real peer.
#
# Behind a reverse proxy this MUST name the proxy, or every request looks like
# it came from it and one bucket is shared by everyone. For the bundled nginx
# (--profile tls) the proxy is a container on this stack's Compose network, so
# the subnet Docker allocates to it is the value — 172.16.0.0/12 covers Docker's
# default pool. Do not use "*": it trusts any client's header.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# TLS verification for outbound MCP connections. On by default. Set to false
# only if you deliberately run an MCP server with a self-signed certificate.
MCP_TLS_VERIFY=true

# Cloud LLM providers — optional, server-wide fallbacks. Each user normally
# stores their own key under Settings → Account (users.gemini_api_key /
# nvidia_api_key / poe_api_key, write-only over the API); these are used only
# when a user has none stored. Leave empty to disable the fallback.
#   Gemini: https://aistudio.google.com/apikey
#   NVIDIA NIM: https://build.nvidia.com
#   Poe: https://poe.com/api/keys — one subscription, every frontier model
GEMINI_API_KEY=
NVIDIA_API_KEY=
POE_API_KEY=

# Hugging Face token for the universal-voice service (gated TTS/ASR models).
HF_TOKEN=

# Sessions. The signing secret is generated into data/jwt_secret.key on first
# run and must survive a restore, or every existing session is invalidated.
# Set JWT_SECRET_KEY only to override that file.
# JWT_SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30

# How long a conversation sits idle before its memory is consolidated.
# CONVERSATION_IDLE_THRESHOLD_MINUTES=30

# How long the API's entrypoint waits for the database before giving up and
# saying why. 60 × 2s = two minutes.
# DB_WAIT_ATTEMPTS=60
# DB_WAIT_INTERVAL=2

# Ceilings that keep a stuck database from silently hanging every request:
# TCP connect, one statement (0 disables), and how long a request waits for
# the database thread before answering 503.
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_SECONDS=30
# DB_OPERATION_TIMEOUT_SECONDS=60

# Where gesture detection (YOLOv8-Pose) runs: cpu, cuda, or leave empty to use
# a GPU when the container can see one and the CPU otherwise. Camera vision
# works without a GPU, just slower.
# VISION_DEVICE=
